# ==============================================================================
# DRISHTI-SWARM: Natural Disaster Intelligence Platform Configuration
# ==============================================================================

# OpenRouter AI Configuration (Using openrouter/free model ID)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenRouteService & Free Routing Engine
# Keyless free OSRM routing is enabled by default
OPENROUTESERVICE_API_KEY=
OPENROUTE_API_KEY=
OPENROUTE_BASE_URL=https://api.openrouteservice.org/v2/directions/driving-car
OSRM_FREE_ROUTING_URL=https://router.project-osrm.org/route/v1/driving

# NASA EOSDIS FIRMS Satellite Key (Optional - keyless real-time VIIRS/MODIS CSV stream is used by default)
NASA_FIRMS_MAP_KEY=your_nasa_firms_key_here

# Open-Meteo Hydrological Flood & River Discharge API (Free / Keyless)
OPEN_METEO_FLOOD_URL=https://flood-api.open-meteo.com/v1/flood

# USGS Seismology Real-Time Feed (Free / Keyless)
USGS_EARTHQUAKE_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson

# Optional Other LLM API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Application Host & Environment
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
